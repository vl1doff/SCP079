<Window x:Class="SCP079.HackChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ВЗЛОМ ЩИТКА 079" Height="380" Width="480"
        Background="#0A0F0A"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="ВЗЛОМ ЩИТКА 079"
                   Foreground="#33FF66" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1"
                   Text="079 видит твои действия. Что ты будешь делать?"
                   Foreground="#88FF88" FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,15,0,20"
                   HorizontalAlignment="Center"/>

        <Border Grid.Row="2"
                Background="#050A05" BorderBrush="#1E7A38"
                BorderThickness="1" CornerRadius="4" Padding="15"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="[1]  ОБЪЯСНИТЬСЯ"
                           Foreground="#33FF66" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Попробовать договориться. Мирный путь."
                           Foreground="#88FF88" FontSize="11" Margin="0,4,0,8"/>
                <Button Content="Выбрать" Click="Explain_Click"
                        Background="#1E7A38" Foreground="#33FF66"
                        FontFamily="Consolas" Padding="10,4"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Background="#050A05" BorderBrush="#1E7A38"
                BorderThickness="1" CornerRadius="4" Padding="15">
            <StackPanel>
                <TextBlock Text="[2]  ВЗЛОМАТЬ СИЛОЙ"
                           Foreground="#33FF66" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Быстро, но опасно. Он будет мешать."
                           Foreground="#88FF88" FontSize="11" Margin="0,4,0,8"/>
                <Button Content="Выбрать" Click="Force_Click"
                        Background="#1E7A38" Foreground="#33FF66"
                        FontFamily="Consolas" Padding="10,4"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="4"
                Content="ОТМЕНА"
                Click="Cancel_Click"
                Background="#3A1A1A" Foreground="#FF8888"
                FontFamily="Consolas" Padding="10,4"
                HorizontalAlignment="Center"
                Margin="0,15,0,0"/>
    </Grid>
</Window>