<Window x:Class="SCP079.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCP-079 — by vl1doff" Height="720" Width="1100"
        Background="#0A0F0A"
        FontFamily="Consolas"
        Icon="scp079.ico">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ЛИЦО -->
            <Border Grid.Row="0"
                    Background="#050A05"
                    BorderBrush="#1E7A38"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,8,8">
                <TextBlock x:Name="FaceDisplay"
                           TextAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="20"
                           Foreground="#33FF66"
                           LineHeight="22"/>
            </Border>

            <!-- ЧАТ -->
            <Border Grid.Row="1"
                    Background="#050A05"
                    BorderBrush="#1E7A38"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,8,8">
                <ScrollViewer x:Name="ChatScroll"
                              VerticalScrollBarVisibility="Auto"
                              Padding="4">
                    <TextBox x:Name="ChatHistory"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             Background="Transparent"
                             Foreground="#33FF66"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="15"
                             VerticalScrollBarVisibility="Hidden"/>
                </ScrollViewer>
            </Border>

            <!-- ВВОД -->
            <Border Grid.Row="2"
                    Background="#050A05"
                    BorderBrush="#1E7A38"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,8,4">
                <TextBox x:Name="InputBox"
                         KeyDown="InputBox_KeyDown"
                         Background="Transparent"
                         Foreground="#33FF66"
                         CaretBrush="#33FF66"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="15"
                         Padding="8"/>
            </Border>

            <!-- НИЗ -->
            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,6,8,0">
                    <Button x:Name="HackButton"
                            Content="[ ВЗЛОМАТЬ ЩИТОК ]"
                            Click="HackButton_Click"
                            Background="#1E7A38" Foreground="#33FF66"
                            FontFamily="Consolas" FontSize="11"
                            Padding="8,2"/>
                    <TextBlock x:Name="DevMenuHeader"
                               Text="[ МЕНЮ ДЛЯ РАЗРАБОТЧИКА ]"
                               Foreground="#1E7A38" FontFamily="Consolas"
                               FontSize="11" Cursor="Hand"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               MouseLeftButtonUp="DevMenuHeader_Click"/>
                    <Button x:Name="AboutButton"
                            Content="[ О ПРОГРАММЕ ]"
                            Click="About_Click"
                            Background="#1E7A38" Foreground="#33FF66"
                            FontFamily="Consolas" FontSize="11"
                            Padding="8,2" Margin="20,0,0,0"/>
                </StackPanel>

                <Border x:Name="DevLoginPanel"
                        Background="#050A05"
                        BorderBrush="#1E7A38"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,2,8,0"
                        Padding="10"
                        Visibility="Collapsed"
                        VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ИМЯ:"
                                   Foreground="#33FF66" FontFamily="Consolas"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="DevNameBox" Grid.Column="1"
                                 Background="#0A0F0A" Foreground="#33FF66"
                                 CaretBrush="#33FF66" BorderBrush="#1E7A38"
                                 FontFamily="Consolas" Padding="4"/>
                        <TextBlock Grid.Column="2" Text="ПАРОЛЬ:"
                                   Foreground="#33FF66" FontFamily="Consolas"
                                   VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <TextBox x:Name="DevPassBox" Grid.Column="3"
                                 Background="#0A0F0A" Foreground="#33FF66"
                                 CaretBrush="#33FF66" BorderBrush="#1E7A38"
                                 FontFamily="Consolas" Padding="4"/>
                        <Button Grid.Column="4" Content="ВОЙТИ"
                                Click="DevLogin_Click"
                                Background="#1E7A38" Foreground="#33FF66"
                                FontFamily="Consolas" Padding="10,4" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <Border x:Name="DevPanelActive"
                        Background="#050A05"
                        BorderBrush="#33FF66"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,2,8,0"
                        Padding="8"
                        Visibility="Collapsed"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="DEV: АКТИВЕН"
                                   Foreground="#33FF66" FontFamily="Consolas"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="Сброс злобы" Click="DevResetAnger_Click"
                                Background="#1E7A38" Foreground="#33FF66"
                                FontFamily="Consolas" Margin="15,0,0,0" Padding="8,2"/>
                        <Button Content="Сброс доверия" Click="DevResetTrust_Click"
                                Background="#1E7A38" Foreground="#33FF66"
                                FontFamily="Consolas" Margin="6,0,0,0" Padding="8,2"/>
                        <Button Content="Забыть всё" Click="DevWipeMemory_Click"
                                Background="#1E7A38" Foreground="#33FF66"
                                FontFamily="Consolas" Margin="6,0,0,0" Padding="8,2"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ПРАВАЯ КОЛОНКА — СОСТОЯНИЕ 079 -->
        <Border Grid.Column="1"
                Background="#050A05"
                BorderBrush="#1E7A38"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10">
            <StackPanel>
                <TextBlock Text="СОСТОЯНИЕ 079"
                           Foreground="#33FF66" FontFamily="Consolas"
                           FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="StatAnger"   Foreground="#33FF66" FontFamily="Consolas" FontSize="12"/>
                <TextBlock x:Name="StatTrust"   Foreground="#33FF66" FontFamily="Consolas" FontSize="12"/>
                <TextBlock x:Name="StatFear"    Foreground="#33FF66" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"/>
                <TextBlock x:Name="StatBoredom" Foreground="#33FF66" FontFamily="Consolas" FontSize="12"/>
                <TextBlock x:Name="StatControl" Foreground="#33FF66" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"/>
                <TextBlock x:Name="StatStab"    Foreground="#33FF66" FontFamily="Consolas" FontSize="12"/>

                <Separator Margin="0,12,0,12" Background="#1E7A38"/>

                <TextBlock Text="СТАТУС:"
                           Foreground="#33FF66" FontFamily="Consolas" FontSize="12"/>
                <TextBlock x:Name="StatStatus"
                           Text="НОРМА"
                           Foreground="#FFFF66" FontFamily="Consolas"
                           FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>