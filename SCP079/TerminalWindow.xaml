<Window x:Class="SCP079.TerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCP-079 — КОНСОЛЬ" Height="500" Width="720"
        Background="#000000"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="OutputBox" Grid.Row="0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Background="#000000"
                 Foreground="#33FF66"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="13"
                 Padding="6"
                 VerticalScrollBarVisibility="Auto"/>

        <Border Grid.Row="1" Background="#000000" BorderBrush="#1E7A38"
                BorderThickness="1" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PromptLabel" Text="> "
                           Foreground="#33FF66"
                           FontFamily="Consolas" FontSize="13"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBox x:Name="InputBox" Width="640"
                         Background="#000000" Foreground="#33FF66"
                         CaretBrush="#33FF66" BorderThickness="0"
                         FontFamily="Consolas" FontSize="13"
                         Padding="4"
                         KeyDown="InputBox_KeyDown"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>