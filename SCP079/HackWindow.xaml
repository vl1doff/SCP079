<Window x:Class="SCP079.HackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ВЗЛОМ ЩИТКА 079" Height="720" Width="920"
        Background="#0A0F0A"
        FontFamily="Consolas"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="ВЗЛОМ ЩИТКА 079"
                       Foreground="#33FF66" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Left"/>
            <TextBlock x:Name="TimerText" Text="00:30"
                       Foreground="#FFFF66" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="1" Background="#050A05"
                BorderBrush="#1E7A38" BorderThickness="1"
                CornerRadius="4" Margin="0,10,0,10" MinHeight="100">
            <ScrollViewer x:Name="DialogScroll"
                          VerticalScrollBarVisibility="Auto"
                          Padding="6">
                <TextBlock x:Name="DialogText"
                           Foreground="#33FF66" FontSize="13"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="#050A05"
                BorderBrush="#1E7A38" BorderThickness="1"
                CornerRadius="4" Height="260" Margin="0,0,0,10">
            <Canvas x:Name="SensorCanvas"
                    Width="880" Height="240"
                    Background="#030603"/>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="LeverA" Content="A ▲" Click="Lever_Click" Tag="A"
                        Width="100" Height="60" Margin="4"
                        Background="#1E7A38" Foreground="#33FF66"
                        FontFamily="Consolas" FontSize="14"/>
                <Button x:Name="LeverB" Content="B ▲" Click="Lever_Click" Tag="B"
                        Width="100" Height="60" Margin="4"
                        Background="#1E7A38" Foreground="#33FF66"
                        FontFamily="Consolas" FontSize="14"/>
                <Button x:Name="LeverC" Content="C ▲" Click="Lever_Click" Tag="C"
                        Width="100" Height="60" Margin="4"
                        Background="#1E7A38" Foreground="#33FF66"
                        FontFamily="Consolas" FontSize="14"/>
                <Button x:Name="LeverD" Content="D ▲" Click="Lever_Click" Tag="D"
                        Width="100" Height="60" Margin="4"
                        Background="#1E7A38" Foreground="#33FF66"
                        FontFamily="Consolas" FontSize="14"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <ProgressBar x:Name="ProgressBar" Height="24"
                             Minimum="0" Maximum="100"
                             Background="#050A05" Foreground="#33FF66"
                             BorderBrush="#1E7A38" BorderThickness="1"/>
                <TextBlock x:Name="ProgressText"
                           Text="0%" Foreground="#33FF66"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"/>
            </Grid>

            <Button x:Name="HoldButton" Grid.Row="2"
                    Content="[ ЗАДЕРЖАТЬ ]"
                    Visibility="Collapsed"
                    Margin="0,10,0,0"
                    Height="50"
                    Background="#5A1010" Foreground="#FF8888"
                    FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>